<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VK_UI3.Views.LoginWindow.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VK_UI3.Views.LoginWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootGrid"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    mc:Ignorable="d">
    <Page.Resources>
        <ThemeShadow x:Name="SharedShadow" />
    </Page.Resources>

    <Grid
        Margin="50"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
        CornerRadius="8"
        Translation="0,0,8">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>

        <ScrollView>

            <StackPanel
                Margin="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Translation="0,0,8">

                <Viewbox Width="100" Height="100">
                    <Image AutomationProperties.Name="Логотип приложения" Source="ms-appx:///Assets/StoreLogo.scale-400.png" />
                </Viewbox>
                <TextBlock
                    Margin="0,0,0,10"
                    AutomationProperties.Name="Введите Логин"
                    Text="Введите Логин" />

                <Grid
                    Margin="0,0,0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="LoginTextBox"
                        Grid.Column="0"
                        AutomationProperties.Name="Поле ввода логина"
                        KeyDown="LoginTextBox_KeyDown" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Помощь по логину">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <TextBlock
                                    Width="250"
                                    Text="Логином может являться ваш номер телефона или электронная почта, на которую зарегистрирован ваш аккаунт ВКонтакте (VK)."
                                    TextWrapping="Wrap" />
                            </Flyout>
                        </Button.Flyout>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="?" />
                    </Button>
                </Grid>
                <TextBlock
                    x:Name="errorTextBlock"
                    Width="300"
                    Foreground="Red"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />

                <ToggleSwitch
                    x:Name="PrivacyToggle"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Согласие с политикой конфиденциальности"
                    IsOn="False"
                    OffContent="Я принимаю Политику конфиденциальности"
                    OnContent="Я принимаю Политику конфиденциальности" />

                <ToggleSwitch
                    x:Name="StatSlyToggle"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Отправлять анонимную статистику использования"
                    IsOn="True"
                    OffContent="Отправлять анонимную статистику использования"
                    OnContent="Отправлять анонимную статистику использования" />

                <Button
                    x:Name="LoginButton"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Кнопка входа"
                    Click="LoginButton_Click"
                    Content="Войти"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />

                <Button
                    x:Name="BackBTN"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Кнопка отмены"
                    Click="BackButton"
                    Content="Отмена" />
                <TextBlock Margin="0,20,0,0" TextAlignment="Center">
                    <Hyperlink NavigateUri="https://t.me/VK_M_creator">Music M в telegram</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,8,0,0" TextAlignment="Center">
                    <Hyperlink Click="PrivacyPolicyLink_Click">Политика конфиденциальности</Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollView>
    </Grid>


</Page>
